# Frontend em modo desenvolvimento (Vite dev server com hot reload)
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# polling garante o hot reload com bind mount no Windows/WSL
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
